{
	"name": "guardian-virus-scan",
	"displayName": "Guardian — Glassworm & Malware Scanner",
	"description": "Glassworm & malware scanner for VS Code. Detects malicious workspace tasks, injected configs, fake fonts, and stealth propagation scripts across Git branches.",
	"version": "1.4.0",
	"publisher": "ankushlokhande",
	"license": "MIT",
	"icon": "media/logo.png",
	"galleryBanner": {
		"color": "#0B0F19",
		"theme": "dark"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ankush-ppie/guardian-virus-scan.git"
	},
	"bugs": {
		"url": "https://github.com/ankush-ppie/guardian-virus-scan/issues"
	},
	"homepage": "https://github.com/ankush-ppie/guardian-virus-scan#readme",
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Linters",
		"Other"
	],
	"keywords": [
		"guardian",
		"guardian-virus-scan",
		"guardian-security",
		"virus-scan",
		"glassworm",
		"glass-worm",
		"force-push",
		"force-push-protection",
		"commit-amend",
		"tasks-json",
		"autorun",
		"auto-run",
		"stealth-terminal",
		"fake-font",
		"font-malware",
		"injected-config",
		"malware",
		"malware-scanner",
		"security",
		"virus",
		"antivirus",
		"backdoor",
		"trojan",
		"supply-chain",
		"supply-chain-attack",
		"threat-detection",
		"payload-detection",
		"malicious",
		"scan",
		"scanner",
		"git",
		"git-security",
		"branch",
		"workspace-security",
		"vscode-security",
		"tasks-security",
		"vulnerability",
		"code-security",
		"obfuscation"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "guardian.scanAllBranches",
				"title": "Guardian: Scan for Glassworm & Workspace Threats"
			},
			{
				"command": "guardian.openReport",
				"title": "Guardian: Open Glassworm & Security Report"
			},
			{
				"command": "guardian.auditExtensions",
				"title": "Guardian: Scan Installed Extensions for Malware"
			}
		],
		"configuration": {
			"title": "Guardian",
			"properties": {
				"guardian.fetchRemotesBeforeScan": {
					"type": "boolean",
					"default": true,
					"description": "Automatically fetch remote branch metadata (git fetch --all --prune) before scanning to detect newly created or updated remote branches."
				}
			}
		}
	},
	"scripts": {
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"vscode:prepublish": "tsc -p ./",
		"test": "npm run compile && node out/scanner.test.js"
	},
	"devDependencies": {
		"@types/vscode": "^1.85.0",
		"@types/node": "^20.0.0",
		"typescript": "^5.3.0"
	}
}
